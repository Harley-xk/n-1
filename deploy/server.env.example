# n-1 生产运行配置模板：复制为 server.env 放服务器 /opt/n1/，逐项修改标「必改」的占位值
# 发布包直部署方案经 systemd EnvironmentFile 注入，修改后 systemctl restart n1 生效；
# Docker 方案经 compose env_file 注入，修改后 compose up -d 重建容器生效

NODE_ENV=production
PORT=3000

# ---- 数据库（外置 PostgreSQL） ----
DB_TYPE=postgres
# 必改：数据库与服务器同机填 127.0.0.1；独立数据库服务器填其内网 IP
# （Docker 方案：同机数据库填 host.docker.internal，compose 已映射 host-gateway）
DB_HOST=127.0.0.1
DB_PORT=5432
# 必改：数据库账号
DB_USERNAME=n_1
# 必改：数据库口令
DB_PASSWORD=<修改为实际口令>
DB_DATABASE=n_1
# 保持 false：生产强制关闭，建表与升级由发布时的迁移自动执行（发布包部署脚本 / docker 启动脚本，ADR-005）
DB_SYNC=false

# ---- 认证 ----
# 必改：长随机串，沿用开发默认值会启动失败（fail-fast 校验）
JWT_SECRET=<修改为长随机串>
JWT_EXPIRES=8h
# 必改：种子账号 admin 的初始口令
USER_INIT_PASSWORD=<修改为种子账号初始口令>

# ---- 请求签名 ----
# 必改：须与 CI 流水线变量 VITE_SIGN_SECRET 完全一致，不一致表现为登录后所有写请求被拒
SIGNATURE_ENABLED=true
SIGNATURE_SECRET=<修改为长随机串，与前端构建密钥一致>
SIGNATURE_EXPIRE_MS=300000

# ---- Swagger ----
# 生产建议关闭（/api-docs 随之失效）
SWAGGER_ENABLED=false
