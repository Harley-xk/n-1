{
  "name": "web",
  "version": "0.1.0",
  "description": "n-1 前端应用（Vue 3 + Pinia + Element Plus）",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "run-p type-check \"build-only {@}\" --",
    "build-only": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "type-check": "vue-tsc --build",
    "lint": "eslint . --fix",
    "format": "prettier --write \"src/**/*.css\"",
    "lint:staged": "lint-staged"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@noble/hashes": "^2.4.0",
    "axios": "^1.7.9",
    "element-plus": "^2.14.5",
    "pinia": "^4.0.3",
    "vue": "^3.5.42",
    "vue-router": "^5.3.1",
    "vxe-pc-ui": "^4.18.19",
    "vxe-table": "^4.22.2",
    "xe-utils": "^4.1.2"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^22.20.3",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.10.0",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-vue": "^10.11.0",
    "globals": "^17.12.0",
    "jsdom": "^30.1.1",
    "lint-staged": "^17.6.0",
    "npm-run-all2": "^7.0.2",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.11"
  }
}
