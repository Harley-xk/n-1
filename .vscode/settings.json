// VS Code 仓库级设置：统一格式化与保存行为（与 .editorconfig / .gitattributes / ESLint 配套）
{
  // 文本文件统一 LF（macOS + Windows 混合开发）
  "files.eol": "\n",
  "files.insertFinalNewline": true,
  "files.trimTrailingWhitespace": true,

  // 代码文件默认格式化器指定为 ESLint 扩展：按 @stylistic 规则输出（无分号 / 单引号 / 2 空格）。
  // 若不指定，内置 TypeScript 格式化器会输出双引号 + 分号，与项目 ESLint 风格打架（保存后风格回退）
  "[javascript]": { "editor.defaultFormatter": "dbaeumer.vscode-eslint" },
  "[typescript]": { "editor.defaultFormatter": "dbaeumer.vscode-eslint" },
  "[typescriptreact]": { "editor.defaultFormatter": "dbaeumer.vscode-eslint" },
  "[vue]": { "editor.defaultFormatter": "dbaeumer.vscode-eslint" },

  // 双保险：即便使用内置 TS / JS 格式化器（如未装 ESLint 扩展），也输出与项目一致的风格
  "typescript.preferences.quotePreference": "single",
  "typescript.format.semicolons": "remove",
  "javascript.preferences.quotePreference": "single",
  "javascript.format.semicolons": "remove",

  // 保存时自动执行 ESLint 修复：AI 产出的代码一保存即被自动整形
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit"
  },

  // ESLint（flat config）：校验 TS / JS / Vue
  "eslint.useFlatConfig": true,
  "eslint.validate": ["javascript", "typescript", "vue"],

  // Markdown 行尾双空格为换行语义，不做行尾裁剪（与 .editorconfig 一致）
  "[markdown]": {
    "files.trimTrailingWhitespace": false
  }
}
