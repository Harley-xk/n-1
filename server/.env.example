# 后端环境变量模板（使用方式：copy .env.example .env，含密钥的 .env 不入库）

# 服务端口
PORT=3000

# 数据库连接配置：默认与首选 PostgreSQL（独立部署，按实际环境填写）。
# 切换数据库：修改 DB_TYPE 与连接参数并安装对应驱动包，详见 docs/架构设计.md「数据访问」
DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=n_1
DB_PASSWORD=n_1@2026
DB_DATABASE=n_1

# 开发环境自动同步实体结构（仅开发便利，迁移接管后建议关闭）；
# 生产环境（NODE_ENV=production）强制关闭并告警，建表与升级走 pnpm --filter server migration:run
DB_SYNC=true

# Swagger 接口文档开关
SWAGGER_ENABLED=true

# 请求签名验证（写方法 HMAC-SHA256 校验，详见 docs/指南/请求签名验证设计.md）
# 密钥需与前端 VITE_SIGN_SECRET 一致；生产环境必须开启并替换为足够长的随机串
SIGNATURE_ENABLED=true
SIGNATURE_SECRET=change-me-to-a-long-random-string
SIGNATURE_EXPIRE_MS=300000

# 认证（JWT 签发与验签，详见 docs/指南/权限设计.md；ADR-003 无状态方案）
# 默认值为开发密钥仅供本地；生产环境必须配置独立随机串，否则服务启动 fail-fast
JWT_SECRET=dev-jwt-secret-change-me
# token 有效期（如 8h / 30m / 120s），默认 8 小时，无刷新 token
JWT_EXPIRES=8h

# 新建用户的默认初始口令（批次五迁入参数表驱动）
USER_INIT_PASSWORD=admin123
